<Page x:Class="LungCancerIdentifierFrontEnd.Views.PatchViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1e1e1e">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="Back" Click="Back_Click" Padding="15,5"/>
            <TextBlock DockPanel.Dock="Right" x:Name="TitleText" Foreground="White"
                       VerticalAlignment="Center" FontSize="14"/>
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="GroundTruthText" Foreground="#FFD580"
                   FontSize="13" Margin="0,0,0,10"/>

        <Grid Grid.Row="2" Background="Black">
            <Image x:Name="SliceImage" Stretch="Uniform"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Slice:" Foreground="White"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Slider Grid.Column="1" x:Name="SliceSlider"
                    ValueChanged="SliceSlider_ValueChanged" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" x:Name="SliceText" Foreground="White"
                       VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="60"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="RunButton" Content="Run Inference"
                    Click="RunButton_Click" Padding="20,8"/>
            <TextBlock x:Name="ResultText" Foreground="#9CDCFE"
                       VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
        </StackPanel>
    </Grid>
</Page>
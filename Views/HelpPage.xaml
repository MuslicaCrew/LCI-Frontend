<Page x:Class="LungCancerIdentifierFrontEnd.Views.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Content="← Vissza"
                Style="{StaticResource BackButton}"
                HorizontalAlignment="Left"
                Click="Back_Click"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520">

            <TextBlock Text="LCI Használati útmutató"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource ForegroundBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

           
            <Border Background="{StaticResource ButtonBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="1.  Kezdés" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Nem biztos abban, hogy a CT felvételen dagantos megbetegedést lát vagy sem? Nyomja meg a Start gombot, válassza ki a fájlt és a program elvégzi az elemzést."
                               FontSize="13" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource ButtonBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="2.  Útmutató" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Ezen a képernyőn található az alkalmazás használati útmutatója. Nyomja meg a Vissza gombot a főképernyőre való visszatéréshez bármikor."
                               FontSize="13" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource ButtonBackgroundBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="3.  Kilépés" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Nyomja meg a Kilépés gombot a főképernyőn az alkalmazás bezárásához."
                               FontSize="13" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>

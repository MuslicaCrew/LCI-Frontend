<Page x:Class="LungCancerIdentifierFrontEnd.Views.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Back button row -->
            <RowDefinition Height="*"/>      <!-- Content -->
        </Grid.RowDefinitions>

     
        <Button Grid.Row="0"
                Content="← Back"
                Style="{StaticResource BackButton}"
                HorizontalAlignment="Left"
                Click="Back_Click"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Open a patch file for scanning"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource ForegroundBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Click the button below to browse for a file on your system."
                       FontSize="14"
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="ResultText"
                       Text="Your results will appear here."
                    Foreground="{StaticResource ForegroundBrush}"
                    FontSize="16"
                       HorizontalAlignment="Center"
                    Margin="0,15,0,20"/>


            <StackPanel HorizontalAlignment="Center">
                <Grid Width="384" Height="384" Margin="0,20,0,0">
                    <Image x:Name="BaseImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Image x:Name="OverlayImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
                <TextBlock x:Name="SliceText"
           Text="Slice 32 / 64"
           Foreground="{StaticResource ForegroundBrush}"
           HorizontalAlignment="Center"
           Margin="0,8,0,0"/>
                <Grid Width="384" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
               Text="1"
               Foreground="{StaticResource ForegroundBrush}"
               VerticalAlignment="Center"
               Margin="0,0,8,0"/>

                    <Slider Grid.Column="1"
            x:Name="SliceSlider"
            Minimum="0" Maximum="63" Value="32"
            VerticalAlignment="Center"
            IsEnabled="False"
            ValueChanged="SliceSlider_ValueChanged"/>

                    <TextBlock Grid.Column="2"
               Text="64"
               Foreground="{StaticResource ForegroundBrush}"
               VerticalAlignment="Center"
               Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Open File Button -->
            <Button Content="📂  Browse File"
                    Style="{StaticResource OpenFileButton}"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20"
                    Click="OpenFile_Click"/>

            <!-- File path display box -->
            <Border Background="{StaticResource ButtonBackgroundBrush}"
                    CornerRadius="8"
                    Padding="16"
                    MinWidth="420"
                    MinHeight="56"
                    VerticalAlignment="Center">
                <TextBlock x:Name="FilePathText"
                           Text="No file selected."
                           Foreground="#AAAAAA"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Border>

        </StackPanel>
    </Grid>
</Page>
